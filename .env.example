# PLDT H153-381 Modem WAN Traffic & Throttling Analytics System Configuration

# Modem Gateway Web UI URL & Credentials
# Default PLDT H153-381 modem IP is http://192.168.1.1/
MODEM_URL=http://192.168.1.1/

# Default username for PLDT H153-381 modems is typically 'pldthome' or 'admin'
MODEM_USER=pldthome
MODEM_PASS=YOUR_MODEM_PASSWORD_HERE

# Analytics System Server Port
PORT=8085
